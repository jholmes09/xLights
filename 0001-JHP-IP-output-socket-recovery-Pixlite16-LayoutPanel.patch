             chan += thissend;
         }
         FrameOutput();
+        if (NoteSendResult(allSent)) {
+            spdlog::warn("DDP output to {}: {} frames failed to send in a row ({}). Closing the socket; it will be reopened automatically.",
+                         _remoteIp, SEND_FAILURES_BEFORE_CLOSE, _datagram->LastError());

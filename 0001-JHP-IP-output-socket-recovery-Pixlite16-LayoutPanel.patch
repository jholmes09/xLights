+            // than that - DDPOutput::Close() also frees the channel buffer, which
+            // would silently discard every channel written until outputs were
+            // cycled - and recovery must leave the output otherwise intact.
+            delete _datagram;
+            _datagram = nullptr;
+        }
     } else {
         SkipFrame();
     }
